# Copy to .env and fill in what you have. Names only in this file, never values.

# Binance Web3 API (web3.binance.com/en/dev-portal, with the B402 Payments permission on the project).
# Without these the worker still reads filings, prices and exits from public endpoints, routes fall
# back to PancakeSwap, simulation falls back to the RPC, and the x402 endpoint answers 503.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# BSC mainnet RPC (blank = public dataseed)
BSC_RPC_URL=
NEXT_PUBLIC_BSC_RPC_URL=

# Operator key, cast wallet new --json > keys/operator.json. Pays gas for receipts and mirrors. Never commit.
OPERATOR_KEYFILE=keys/operator.json
# Burner follower for scripts/e2e.ts, same format
FOLLOWER_KEYFILE=keys/follower-burner.json
# TailcoatMirror address once deployed (scripts/deploy.sh prints it)
NEXT_PUBLIC_MIRROR_ADDRESS=
# Cash token followers spend; USDT on BSC by default
CASH_TOKEN=0x55d398326f99059fF775485246999027B3197955

# Filing reader: Claude Opus 5.5 first (ANTHROPIC_API_KEY), then OpenRouter, then Sarvam
ANTHROPIC_API_KEY=
READER_CLAUDE_MODEL=claude-opus-5-5
OPENROUTER_API_KEY=
SARVAM_API_KEY=

# EDGAR requires a descriptive User-Agent with a contact, e.g. "Tailcoat you@example.com"
SEC_USER_AGENT=

# libSQL file (blank = file:./data/tailcoat.db)
DATABASE_URL=
NEXT_PUBLIC_SITE_URL=https://tailcoat.adilhusain.xyz

# The Agent Studio seller, shown on /app/agent
NEXT_PUBLIC_AGENT_URL=https://agent.tailcoat.adilhusain.xyz
NEXT_PUBLIC_AGENT_WALLET=
NEXT_PUBLIC_AGENT_ERC8004_ID=

# x402 pay-per-call on /api/x402/filing/[docId]
X402_PRICE_USD=0.01
X402_PAY_TO=

# Worker tuning
HOUSE_WATCHLIST=pelosi,khanna,gottheimer,mccaul,greene,crenshaw,tuberville
HOUSE_INDEX_WINDOW=1000
READ_BATCH=2
INGEST_INTERVAL_MS=60000
TRADE_INTERVAL_MS=20000
# Largest gap allowed between the route's implied price and the reference price, as a fraction
MAX_PRICE_DEVIATION=0.03
# Slippage on routes, percent
SLIPPAGE_PERCENT=1
# Registry cache file and refresh age
REGISTRY_CACHE=
REGISTRY_MAX_AGE_MS=3600000

# Hosted deployment (see docs/DEPLOY.md): Turso for both sides, the operator key on the worker as an env var.
# Turso: libsql://<db>.turso.io plus its token; blank keeps the local file
DATABASE_AUTH_TOKEN=
# The operator key as a hex private key, instead of a key file
OPERATOR_PRIVATE_KEY=
# Shared secret for /api/cron/* (Vercel cron sends it as a bearer token)
CRON_SECRET=
