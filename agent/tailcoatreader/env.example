# Names only. The real file is agent/tailcoatreader/.studio/.env.local (gitignored, mode 0600).
# `bag wallet new --generate-password` writes WALLET_PASSWORD and the keystore itself.
WALLET_PASSWORD=
ANTHROPIC_API_KEY=
# Where the agent fetches parsed filings from (the Tailcoat site)
TAILCOAT_URL=https://tailcoat.adilhusain.xyz
# B402 merchant credentials for the paid x402 face, issued by Binance OnchainPay after approval.
# All four or none; without them the x402 face answers 503 "rail dormant" and ERC-8183 still works.
B402_BASE_URL=
B402_CLIENT_ID=
B402_ACCESS_TOKEN=
B402_PRIVATE_KEY=
